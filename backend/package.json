{
  "name": "@repo/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "yarn workspace @repo/shared build && tsc -p tsconfig.json",
    "dev": "yarn workspace @repo/shared build && tsc -p tsconfig.json && node dist/main.js",
    "typecheck": "yarn workspace @repo/shared build && tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@repo/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
